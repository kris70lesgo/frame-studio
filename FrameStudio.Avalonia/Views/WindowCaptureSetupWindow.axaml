<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="using:FrameStudio.Platform.Abstractions"
        x:Class="FrameStudio.Avalonia.Views.WindowCaptureSetupWindow"
        Title="Set up window recording"
        Width="560" Height="420" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundPrimary}"
        FontFamily="Inter, Segoe UI, sans-serif">
    <Border Padding="26">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="17">
            <StackPanel Spacing="5">
                <TextBlock Text="RECORD A WINDOW" Classes="Caption" />
                <TextBlock Text="Choose an application window" Classes="Title" FontSize="22" />
                <TextBlock Text="Frame Studio captures the selected window's rendered content, even when another window overlaps it."
                           Classes="Body" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="7" VerticalAlignment="Top">
                <TextBlock Text="Application window" Classes="Caption" />
                <ComboBox x:Name="WindowPicker" MinHeight="48">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="platform:WindowDescriptor">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Bounds.Width, StringFormat='{}{0} px'}"
                                           FontSize="10" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Padding="12" CornerRadius="6" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <TextBlock Text="Windows asks the selected app to render its own window, so capture can respond slowly. Some hardware-accelerated or protected apps may render blank or incomplete frames; use screen-region recording for those apps."
                               FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="15" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="Frame rate" Classes="Caption" />
                    <Slider x:Name="FrameRateSlider" Minimum="10" Maximum="60" Value="30"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="FrameRateSlider_OnValueChanged" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,7" CornerRadius="7" Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <TextBlock x:Name="FrameRateLabel" Text="30 FPS" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}" />
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <CheckBox x:Name="CaptureCursorCheckBox" Content="Include the pointer"
                          FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
                    <Button Classes="quiet-button" Click="Cancel_OnClick" Content="Cancel" />
                    <Button Classes="primary-button" Click="Start_OnClick" Content="Choose save location" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
