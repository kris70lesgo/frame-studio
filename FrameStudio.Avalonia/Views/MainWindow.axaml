<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FrameStudio.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FrameStudio.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Frame Studio"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundPrimary}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid RowDefinitions="48,*">
        <!-- Jitter-style tool strip: capture and project actions replace layer creation tools. -->
        <Border Grid.Row="0" Background="#1B1A20" BorderBrush="#302E36" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="11,0" ColumnSpacing="11" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Grid Width="25" Height="25">
                        <Border Width="15" Height="15" CornerRadius="4" BorderThickness="1.6" BorderBrush="#B99CFF"
                                HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Border Width="15" Height="15" CornerRadius="4" BorderThickness="1.6" BorderBrush="#8B5CF6"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="Frame Studio" FontSize="12" FontWeight="SemiBold"
                               Foreground="#F4F3F6" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Button Classes="editor-tool-button selected" IsEnabled="{Binding IsScreenCaptureAvailable}"
                            Click="ScreenCapture_OnClick" ToolTip.Tip="Record a screen or region"
                            AutomationProperties.Name="Record screen or region">
                        <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21"
                              Stroke="#C7B2FF" StrokeThickness="1.5" StrokeLineCap="Round" Width="20" Height="20" />
                    </Button>
                    <Button Classes="editor-tool-button" IsEnabled="False"
                            ToolTip.Tip="Window recording isn't available yet; this build records screen regions."
                            AutomationProperties.Name="Window capture, not available yet">
                        <Path Data="M4,5 L20,5 L20,19 L4,19 Z M4,9 L20,9"
                              Stroke="#D6D4DD" StrokeThickness="1.5" StrokeLineCap="Round" Width="19" Height="19" />
                    </Button>
                    <Button Classes="editor-tool-button" IsEnabled="False"
                            ToolTip.Tip="Webcam recording isn't available yet."
                            AutomationProperties.Name="Webcam capture, not available yet">
                        <Path Data="M4,7 L16,7 L16,17 L4,17 Z M16,10 L21,7 L21,17 L16,14 Z"
                              Stroke="#D6D4DD" StrokeThickness="1.5" StrokeLineCap="Round" Width="20" Height="18" />
                    </Button>
                    <Button Classes="editor-tool-button" IsEnabled="False"
                            ToolTip.Tip="Sketchboard isn't available yet."
                            AutomationProperties.Name="Sketchboard, not available yet">
                        <Path Data="M4,17 L3,21 L7,20 L19,8 L16,5 Z M14,7 L17,10"
                              Stroke="#D6D4DD" StrokeThickness="1.5" StrokeLineCap="Round" Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="New capture" FontSize="12" FontWeight="SemiBold"
                           Foreground="#F4F3F6" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button Grid.Column="3" Classes="toolbar-save-button" Command="{Binding ToggleThemeCommand}"
                        AutomationProperties.Name="Toggle light and dark appearance">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Stroke="#D6D4DD" StrokeThickness="1.4" />
                        <TextBlock Text="{Binding ThemeName}" FontSize="10" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="header-open-button" Click="OpenProject_OnClick"
                        ToolTip.Tip="Open a saved Frame Studio project">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="↗" FontSize="13" />
                        <TextBlock Text="Open project" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Classes="primary-button toolbar-export-button"
                        Click="ScreenCapture_OnClick" IsEnabled="{Binding IsScreenCaptureAvailable}"
                        AutomationProperties.Name="Start a screen recording">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" />
                        <TextBlock Text="Record" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="240,*,260">
            <!-- Project list takes the place of Jitter's layer outline on the start workspace. -->
            <Border Grid.Column="0" Background="{DynamicResource BackgroundSecondary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="48,34,*,Auto">
                    <Grid Margin="15,0,13,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Projects" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Grid.Column="1" Text="{Binding RecentProjectsCountLabel}"
                                   Classes="Caption" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="14,0,12,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="RECENT PROJECTS" Classes="Caption" FontSize="9" />
                        <Button Grid.Column="1" Classes="editor-tool-button" Width="28" Height="28"
                                Click="OpenProject_OnClick" ToolTip.Tip="Browse projects"
                                AutomationProperties.Name="Browse projects">
                            <Path Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" Width="17" Height="17" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,3,8,8">
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentProjectViewModel">
                                        <Button Classes="recent-project-card" Click="OpenRecentProject_OnClick"
                                                AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Path}">
                                            <Grid ColumnDefinitions="29,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                <Border Width="27" Height="27" CornerRadius="4"
                                                        Background="{DynamicResource SurfaceRaised}">
                                                    <Path Data="M5,3 L15,3 L20,8 L20,21 L5,21 Z M15,3 L15,8 L20,8 M8,12 L17,12 M8,16 L17,16"
                                                          Stroke="{DynamicResource Accent}" StrokeThickness="1.3"
                                                          StrokeLineCap="Round" Width="16" Height="16"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="9"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="17"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border IsVisible="{Binding IsRecentProjectsEmpty}" Margin="5,12,5,0" Padding="14,15"
                                    Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="5">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="No projects yet" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Your saved captures will appear here."
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Padding="13,11" BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,1,0,0" Background="{DynamicResource BackgroundSecondary}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" />
                            <TextBlock Text="Saved locally" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Neutral canvas area mirrors Jitter's centered artboard and zoom rail. -->
            <Grid Grid.Column="1" RowDefinitions="42,*,40" Background="{DynamicResource BackgroundPrimary}">
                <Grid Grid.Row="0" Margin="17,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Workspace" FontSize="10" Foreground="{DynamicResource TextTertiary}" />
                        <TextBlock Text="/" FontSize="10" Foreground="{DynamicResource TextTertiary}" />
                        <TextBlock Text="New capture" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,4" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
                        <TextBlock Text="100%" FontSize="9" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="18,4">
                    <Viewbox Stretch="Uniform" MaxWidth="860" MaxHeight="480"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="860" Height="480" Background="#FFFFFF"
                                BorderBrush="#D9D8DF" BorderThickness="1">
                            <Grid RowDefinitions="36,*">
                                <Border Background="#FAFAFB" BorderBrush="#E8E7EC" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#DBD9E1" />
                                            <Ellipse Width="6" Height="6" Fill="#DBD9E1" />
                                            <Ellipse Width="6" Height="6" Fill="#DBD9E1" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="210" Height="7" CornerRadius="4"
                                                Background="#EFEFF2" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="FRAME STUDIO" FontSize="7" FontWeight="SemiBold"
                                                   Foreground="#A7A5AF" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="26" ColumnDefinitions="148,*" ColumnSpacing="25">
                                    <StackPanel Spacing="11" Margin="0,8,0,0">
                                        <Border Width="76" Height="7" CornerRadius="4" Background="#D9D8DF"
                                                HorizontalAlignment="Left" />
                                        <Border Height="1" Background="#ECEBF0" Margin="0,5,0,0" />
                                        <Border Width="116" Height="7" CornerRadius="4" Background="#ECEBF0"
                                                HorizontalAlignment="Left" />
                                        <Border Width="95" Height="7" CornerRadius="4" Background="#ECEBF0"
                                                HorizontalAlignment="Left" />
                                        <Border Width="108" Height="7" CornerRadius="4" Background="#ECEBF0"
                                                HorizontalAlignment="Left" />
                                        <Border Width="86" Height="7" CornerRadius="4" Background="#ECEBF0"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" RowDefinitions="Auto,*,*" RowSpacing="18">
                                        <StackPanel Spacing="9">
                                            <Border Width="174" Height="11" CornerRadius="5" Background="#C9C7D0"
                                                    HorizontalAlignment="Left" />
                                            <Border Width="244" Height="7" CornerRadius="4" Background="#E7E6EB"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                            <Border Background="#F9F9FA" BorderBrush="#E8E7EC" BorderThickness="1" />
                                            <Border Grid.Column="1" Background="#F9F9FA" BorderBrush="#E8E7EC" BorderThickness="1" />
                                            <Border Grid.Column="2" Background="#F9F9FA" BorderBrush="#E8E7EC" BorderThickness="1" />
                                        </Grid>
                                        <Border Grid.Row="2" Background="#FAFAFB" BorderBrush="#E8E7EC" BorderThickness="1">
                                            <Grid Margin="18" RowDefinitions="Auto,*">
                                                <StackPanel Spacing="7">
                                                    <Border Width="142" Height="8" CornerRadius="4" Background="#D9D8DF"
                                                            HorizontalAlignment="Left" />
                                                    <Border Width="98" Height="6" CornerRadius="3" Background="#ECEBF0"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9"
                                                            VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                                    <Border Width="16" Height="70" CornerRadius="2" Background="#B99CFF" />
                                                    <Border Width="16" Height="102" CornerRadius="2" Background="#9C79F3" />
                                                    <Border Width="16" Height="84" CornerRadius="2" Background="#B99CFF" />
                                                    <Border Width="16" Height="122" CornerRadius="2" Background="#7547E8" />
                                                    <Border Width="16" Height="94" CornerRadius="2" Background="#B99CFF" />
                                                    <Border Width="16" Height="112" CornerRadius="2" Background="#9C79F3" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Viewbox>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                            Padding="7,4" CornerRadius="4" Background="#FFFFFF" BorderBrush="#E4E3E9" BorderThickness="1">
                        <TextBlock Text="860 × 480" FontSize="9" FontFamily="Consolas" Foreground="#66656F" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" Margin="17,0"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Warning}" />
                    <TextBlock Text="{Binding CaptureStatus}" FontSize="9" Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Context panel follows Jitter's right-side inspector, with real capture and project tabs. -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundSecondary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <TabControl Background="Transparent" BorderThickness="0" TabStripPlacement="Top">
                    <TabItem Header="Capture">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15,17" Spacing="17">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Capture settings" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Set up a screen recording and turn it into an animation."
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="SOURCE" Classes="Caption" FontSize="9" />
                                    <Border Padding="10,9" CornerRadius="4" Background="{DynamicResource SurfaceRaised}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                            <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                                  StrokeLineCap="Round" Width="18" Height="18"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Screen or region" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="Full display or custom area" FontSize="9"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource Success}"
                                                     VerticalAlignment="Center" IsVisible="{Binding IsScreenCaptureAvailable}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="RECORDING" Classes="Caption" FontSize="9" />
                                    <Border Padding="10" CornerRadius="4" Background="{DynamicResource SurfaceRaised}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <Grid RowDefinitions="Auto,1,Auto" RowSpacing="9">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Frame rate" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="Choose next" FontSize="9"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource Border}" />
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Pointer" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="Optional" FontSize="9"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Frame rate and pointer options are set before recording."
                                               FontSize="9" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Padding="10" CornerRadius="4" Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="After recording" Classes="Caption" FontSize="9" />
                                        <TextBlock Text="Review frames, trim timing, add annotations, then export GIF or MP4."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Classes="primary-button" Click="ScreenCapture_OnClick"
                                        IsEnabled="{Binding IsScreenCaptureAvailable}"
                                        AutomationProperties.Name="Record a screen or region">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" />
                                        <TextBlock Text="Record screen" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Project">
                        <StackPanel Margin="15,17" Spacing="15">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Local projects" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Frame Studio keeps project files on this device."
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Padding="12" CornerRadius="4" Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding RecentProjectsCountLabel}" Classes="Caption" FontSize="9" />
                                    <TextBlock Text="{Binding RecentProjects.Count}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <Button Classes="header-open-button" Click="OpenProject_OnClick"
                                    ToolTip.Tip="Browse for a saved Frame Studio project">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="↗" FontSize="13" />
                                    <TextBlock Text="Browse projects" FontSize="10" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
