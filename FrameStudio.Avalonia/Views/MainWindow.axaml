<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FrameStudio.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="860"
        x:Class="FrameStudio.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Frame Studio"
        Width="1360" Height="860"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundPrimary}"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Grid ColumnDefinitions="236,*">
        <Border Grid.Column="0"
                Background="{DynamicResource BackgroundSecondary}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Margin="22,24,20,20" Spacing="25">
                    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                        <Grid Width="34" Height="34">
                            <Border Width="20" Height="20" CornerRadius="6" BorderThickness="2"
                                    BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Border Width="20" Height="20" CornerRadius="6" BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentStrong}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="FRAME STUDIO" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="CAPTURE WORKSPACE" Classes="Caption" FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="WORKSPACE" Classes="Caption" Margin="4,0,0,2" />
                        <Button Classes="nav-button selected" IsTabStop="True" AutomationProperties.Name="Home">
                            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                                <Path Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" Width="18" Height="18" />
                                <TextBlock Text="Home" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Margin="18,12,18,18" Padding="13"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="11">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Warning}" />
                            <TextBlock Text="MIGRATION IN PROGRESS" Classes="Caption" FontSize="9" />
                        </StackPanel>
                        <TextBlock Text="{Binding CaptureStatus}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="58,*">
            <Border Grid.Row="0" Background="{DynamicResource BackgroundPrimary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="30,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="Workspace" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="/" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                        <TextBlock Text="Home" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="quiet-button" Margin="0,0,10,0" Click="OpenProject_OnClick"
                            ToolTip.Tip="Open a saved Frame Studio project">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="↗" FontSize="14" />
                            <TextBlock Text="Open project" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="quiet-button" Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.Name="Toggle light and dark appearance">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="13" Height="13" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                            <TextBlock Text="{Binding ThemeName}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="{StaticResource PageInset}" Spacing="{StaticResource Space6}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="A better way to capture." Classes="Display" />
                        <TextBlock Text="Record a moment, shape the frames, and export a crisp result."
                                   Classes="Body" FontSize="15" />
                    </StackPanel>

                    <Grid ColumnDefinitions="1.55*,0.92*" ColumnSpacing="16" MinHeight="334">
                        <Border Grid.Column="0" Padding="24" CornerRadius="14"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="22">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="CREATE A CAPTURE" Classes="Caption" />
                                    <TextBlock Text="Choose a source" Classes="Title" FontSize="21" />
                                    <TextBlock Text="Start with the view you want to show."
                                               Classes="Body" FontSize="13" />
                                </StackPanel>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                                    <Button Classes="capture-card" IsEnabled="{Binding IsScreenCaptureAvailable}"
                                            Click="ScreenCapture_OnClick"
                                            AutomationProperties.Name="Record a screen or region"
                                            ToolTip.Tip="Select a display region, record it, and open the captured frames in the editor.">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BackgroundSecondary}"
                                                    VerticalAlignment="Top">
                                                <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21"
                                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" Width="20" Height="20"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Screen" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="Full display or region" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Classes="capture-card" IsEnabled="False"
                                            AutomationProperties.Name="Window capture, not available in this shell build"
                                            ToolTip.Tip="The Window capture service is planned for the next migration milestone.">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BackgroundSecondary}"
                                                    VerticalAlignment="Top">
                                                <Path Data="M4,5 L20,5 L20,19 L4,19 Z M4,9 L20,9"
                                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" Width="19" Height="19"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Window" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="Capture one app" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Row="1" Classes="capture-card" IsEnabled="False"
                                            AutomationProperties.Name="Webcam capture, not available in this shell build"
                                            ToolTip.Tip="Webcam capture will follow the core screen recording workflow.">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BackgroundSecondary}"
                                                    VerticalAlignment="Top">
                                                <Path Data="M4,7 L16,7 L16,17 L4,17 Z M16,10 L21,7 L21,17 L16,14 Z"
                                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" Width="20" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Webcam" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="Record a camera feed" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="capture-card" IsEnabled="False"
                                            AutomationProperties.Name="Sketchboard, not available in this shell build"
                                            ToolTip.Tip="Sketchboard support is planned after screen capture and editing.">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BackgroundSecondary}"
                                                    VerticalAlignment="Top">
                                                <Path Data="M4,17 L3,21 L7,20 L19,8 L16,5 Z M14,7 L17,10"
                                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" Width="20" Height="20"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Sketch" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="Draw an animation" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Warning}" />
                                    <TextBlock Text="Screen region recording is available on Windows."
                                               FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="14" Padding="20"
                                Background="{DynamicResource BackgroundSecondary}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="A CLEAR FRAME" Classes="Caption" />
                                    <TextBlock Text="Made for the details." Classes="Title" FontSize="16" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,17,0,14">
                                    <Border CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <Grid RowDefinitions="28,*">
                                            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="11,0" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextTertiary}" />
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextTertiary}" />
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextTertiary}" />
                                                    <Border Width="75" Height="5" CornerRadius="3" Margin="9,0,0,0" Background="{DynamicResource Border}" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="1" Margin="13">
                                                <Border Background="{DynamicResource BackgroundPrimary}" CornerRadius="6" />
                                                <Border Margin="28,21,28,24" BorderBrush="{DynamicResource Accent}"
                                                        BorderThickness="1.5" CornerRadius="5">
                                                    <Grid>
                                                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="12">
                                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="3" Margin="0,0,5,5" />
                                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="3" Margin="5,0,0,5" />
                                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceRaised}" CornerRadius="3" Margin="0,5,0,0" />
                                                        </Grid>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3" />
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-3" />
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3" />
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-3" />
                                                    </Grid>
                                                </Border>
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                                        Padding="8,4" CornerRadius="4" Background="{DynamicResource SurfaceRaised}"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                    <TextBlock Text="860 × 480" FontSize="9" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Path Data="M4,12 L9,17 L20,6" Stroke="{DynamicResource Accent}" StrokeThickness="1.8"
                                          StrokeLineCap="Round" Width="15" Height="15" />
                                    <TextBlock Text="Precise by design" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Recent projects" Classes="Title" FontSize="17" />
                            <TextBlock Text="Pick up where you left off."
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding RecentProjectsCountLabel}" Classes="Caption" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentProjectViewModel">
                                <Button Classes="recent-project-card" Click="OpenRecentProject_OnClick"
                                        AutomationProperties.Name="{Binding Name}"
                                        ToolTip.Tip="{Binding Path}">
                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="13" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="{DynamicResource BackgroundSecondary}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <Path Data="M5,3 L15,3 L20,8 L20,21 L5,21 Z M15,3 L15,8 L20,8 M8,12 L17,12 M8,16 L17,16"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.35"
                                                  StrokeLineCap="Round" Width="19" Height="19"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OpenedLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="OPEN  ↗" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border IsVisible="{Binding IsRecentProjectsEmpty}" Padding="20" CornerRadius="12" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid ColumnDefinitions="52,*" ColumnSpacing="15" VerticalAlignment="Center">
                            <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource BackgroundSecondary}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <Grid Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource TextTertiary}" BorderThickness="1.4" CornerRadius="3" />
                                    <Path Data="M5,11 L9,7 L16,14 M12,13 L15,10 L19,14"
                                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3"
                                          StrokeLineCap="Round" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Nothing here yet" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Start a capture to make your first project."
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Independent Avalonia port based on ScreenToGif · early shell build"
                               FontSize="10" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
